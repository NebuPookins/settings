#!/usr/bin/env python3

import argparse
import os
import re
import subprocess
import sys
import termios
import tty
from dataclasses import dataclass

RED = '\033[31m'
GREEN = '\033[32m'
RESET = '\033[0m'

RAW_FRAMES_SECTION = 'ID3v2 Raw frames'

# Summary lines look like "Title: Song". Other keys (Comment, Genre, Year, ...) are ignored.
SUMMARY_FIELDS = {'Title': 'title', 'Artist': 'artist', 'Album': 'album'}

# See https://id3.org/id3v2.4.0-frames for the defined frame types. All other frames are ignored.
TEXT_FRAMES = {'TIT2': 'title', 'TPE1': 'artist', 'TALB': 'album'}
NUMBERED_FRAMES = {'TRCK': 'track', 'TPOS': 'disc'}  # Values look like "7" or "7/12".


@dataclass(frozen=True)
class Tags:
    title: str | None = None
    artist: str | None = None
    album: str | None = None
    track: int | None = None
    max_track: int | None = None
    disc: int | None = None
    max_disc: int | None = None


@dataclass(frozen=True)
class Skip:
    reason: str


def getch():
    fd = sys.stdin.fileno()
    old_settings = termios.tcgetattr(fd)
    try:
        tty.setraw(fd)
        return sys.stdin.read(1)
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)


def decode_lines(data):
    """Decodes each line as UTF-8, falling back to Latin-1 (the usual encoding of ID3v1 tags), since a single
    dump can mix both and Latin-1 can decode any byte."""
    def decode(line):
        try:
            return line.decode('utf-8')
        except UnicodeDecodeError:
            return line.decode('latin-1')
    return '\n'.join(decode(line) for line in data.splitlines())


def split_sections(output):
    """Splits mpg123-id3dump output into {section name: section text}, e.g. {'ID3v1': 'Title: Song\\n...'}."""
    parts = re.split(r'^====\s*(.+?)\s*====$', output, flags=re.M)
    return dict(zip(parts[1::2], parts[2::2]))


def parse_summary(text):
    matches = (re.fullmatch(r'(\w+):\s*(.*?)\s*', line) for line in text.splitlines())
    return {SUMMARY_FIELDS[m[1]]: m[2] for m in matches if m and m[1] in SUMMARY_FIELDS and m[2]}


def parse_numbered(frame_name, value):
    match = re.search(r'(\d+)(?:/(\d+))?', value)
    if not match:
        return {}
    numbers = {frame_name: int(match[1]), f'max_{frame_name}': match[2] and int(match[2])}
    return {key: number for key, number in numbers.items() if number is not None}


def parse_raw_frames(text):
    """Frame headers (e.g. "TIT2 language()" or "COMM description() language(eng):") start at column 0,
    and each line of the frame's value is indented by a space. Frames with empty values have no value
    lines, so they never match. Only the first value line is used; later lines only occur in multi-line
    frames like comments and lyrics, which are ignored."""
    frames = re.findall(r'^([A-Z0-9]{4})\b.*\n (.*)', text, flags=re.M)
    return {key: parsed
            for frame_id, value in frames
            for key, parsed in parse_raw_frame(frame_id, value.strip()).items()}


def parse_raw_frame(frame_id, value):
    if frame_id in TEXT_FRAMES:
        return {TEXT_FRAMES[frame_id]: value}
    if frame_id in NUMBERED_FRAMES:
        return parse_numbered(NUMBERED_FRAMES[frame_id], value)
    return {}


def parse_id3dump(output):
    """Raw ID3v2 frames take precedence over the ID3v1/ID3v2 summaries, which are the only source for
    ID3v1-only files."""
    sections = split_sections(output)
    summaries = {key: value
                 for name, text in sections.items() if name != RAW_FRAMES_SECTION
                 for key, value in parse_summary(text).items()}
    raw = parse_raw_frames(sections.get(RAW_FRAMES_SECTION, ''))
    return Tags(**{**summaries, **raw})


def safe_for_filename(name):
    return name.replace('/', '_')


def is_multi_disc(tags):
    return max(tags.max_disc or 1, tags.disc or 1) > 1


def padded(number, max_number):
    width = len(str(max_number)) if max_number is not None else 1
    return f'{number:0{width}d}'


def track_label(tags):
    """"7" for single-disc albums, "2-07" (disc-track) for multi-disc albums."""
    track = padded(tags.track, tags.max_track)
    return f'{padded(tags.disc, tags.max_disc)}-{track}' if is_multi_disc(tags) else track


def new_name_for(tags):
    if tags.artist is None or tags.title is None:
        return Skip('missing artist/title tags')
    if tags.album is None or tags.track is None:
        return safe_for_filename(f'{tags.artist} - {tags.title}') + '.mp3'
    if is_multi_disc(tags) and tags.disc is None:
        return Skip('multi-disc album but the disc number tag is missing')
    return safe_for_filename(f'{tags.album} ({track_label(tags)}) {tags.artist} - {tags.title}') + '.mp3'


def rename_interactively(path):
    directory, file = os.path.split(path)
    # --no-scan skips reading the audio frames; tags are at the start and end of the file.
    raw_output = subprocess.run(['mpg123-id3dump', '--no-scan', path], capture_output=True).stdout
    output = decode_lines(raw_output)
    match new_name_for(parse_id3dump(output)):
        case Skip(reason):
            print(f'Skipping {RED}{path}{RESET}: {reason}')
        case new_name if new_name != file:
            target = os.path.join(directory, new_name)
            if os.path.exists(target):
                # os.rename would silently replace it, e.g. a single and an album copy of the same song.
                print(f'Skipping {RED}{path}{RESET}: {GREEN}{new_name}{RESET} already exists')
                return
            print(f'Renaming from {RED}{file}{RESET}\n           to {GREEN}{new_name}{RESET}\n(y/n)?')
            if getch() == 'y':
                os.rename(path, target)


def main():
    parser = argparse.ArgumentParser(
        description='Rename MP3 files to "Album (Track) Artist - Title.mp3" based on their ID3 tags.')
    parser.add_argument('files', nargs='*',
                        help='files to rename (default: every .mp3 file in the current directory)')
    args = parser.parse_args()
    for path in args.files or sorted(
            name for name in os.listdir('.') if name.lower().endswith('.mp3') and os.path.isfile(name)):
        rename_interactively(path)


if __name__ == '__main__':
    main()
